{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Luma plugin: dev host",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["exec", "--", "luma-plugin", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "luma-plugin: build",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
