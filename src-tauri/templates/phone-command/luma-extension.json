{
  "id": "com.example.phone-command",
  "name": "Phone command",
  "version": "1.0.0",
  "apiVersion": 3,
  "minHostVersion": "0.8.0",
  "description": "Host-rendered paired-phone playback controls backed by on-demand plugin commands.",
  "author": "Luma template",
  "runtime": {
    "kind": "isolated-ui",
    "entry": "ui/index.html"
  },
  "contributes": {
    "commands": ["togglePlayback", "nextTrack"],
    "cards": [
      {
        "id": "controls",
        "title": "Phone controls",
        "command": "togglePlayback"
      }
    ]
  },
  "remote": {
    "title": "Phone controls",
    "commands": [
      { "command": "togglePlayback", "label": "Play or pause" },
      { "command": "nextTrack", "label": "Next" }
    ]
  },
  "permissions": ["playback.control"],
  "assets": ["ui/main.js", "ui/style.css"]
}
